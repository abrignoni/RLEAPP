{
  "name": "RLEAPP",
  "version": "2026.5.1-dev",
  "description": "Returns, Logs, Events and Protobuf Parser",
  "report_description": "RLEAPP is an open source project that aims to parse service provider returns for the purpose of triage analysis.",
